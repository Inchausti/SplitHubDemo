# SplitHub Environment Configuration

# API Configuration
REACT_APP_API_URL=https://api.splithub.com
REACT_APP_API_KEY=your_api_key_here
REACT_APP_AUTH_TOKEN=your_auth_token_here

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AI_ASSISTANT=true
REACT_APP_ENABLE_SIMULATOR=true

# Theme (dark | light)
REACT_APP_DEFAULT_THEME=dark

# Logging
REACT_APP_LOG_LEVEL=info

# Environment
NODE_ENV=development
